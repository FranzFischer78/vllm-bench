#!/usr/bin/env bash
# Pre-push hook: tag a release automatically.
#
# When you push `main` and the version in Cargo.toml has no tag yet, this creates
# the annotated tag v<version> on the pushed commit and pushes it as well.
# The tag push triggers .github/workflows/release.yml (Linux + Windows binaries).
#
# To release: bump `version` in Cargo.toml, commit, `git push`.
# Install:    git config core.hooksPath .githooks
# Skip once:  SKIP_AUTO_TAG=1 git push

set -u

remote="$1"
zero="0000000000000000000000000000000000000000"

if [ "${SKIP_AUTO_TAG:-}" = "1" ]; then
    exit 0
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
# Only pushes of refs/heads/main matter; tag pushes (including our own) are ignored.
main_sha=""
main_remote_sha=""
while read -r _local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "$zero" ]; then
        main_sha="$local_sha"
        main_remote_sha="$remote_sha"
    fi
done

if [ -z "$main_sha" ]; then
    exit 0
fi

# Do not tag a push that the remote will reject (non-fast-forward / force push).
if [ "$main_remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$main_remote_sha" "$main_sha" 2>/dev/null; then
    echo "auto-tag: push is not a fast-forward, skipping tag." >&2
    exit 0
fi

# Read the version from the commit being pushed, not from the working tree.
version=$(git show "$main_sha:Cargo.toml" 2>/dev/null | sed -n 's/^version *= *"\(.*\)".*/\1/p' | head -n 1)
if [ -z "$version" ]; then
    echo "auto-tag: could not read version from Cargo.toml, skipping tag." >&2
    exit 0
fi
tag="v$version"

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    exit 0
fi

remote_tags=$(git ls-remote --tags "$remote" "refs/tags/$tag") || exit 0
if [ -n "$remote_tags" ]; then
    exit 0
fi

echo "auto-tag: creating and pushing $tag (triggers the release workflow)"
git tag -a "$tag" -m "Release $tag" "$main_sha" || exit 0

# --no-verify: do not run this hook again for the tag push.
if ! git push --no-verify "$remote" "refs/tags/$tag"; then
    echo "auto-tag: pushing $tag failed, removing local tag. Your branch push continues." >&2
    git tag -d "$tag" >/dev/null
fi

exit 0
